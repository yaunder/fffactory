{
  "name": "fffactory",
  "version": "0.0.2",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "fffactory": "bun src/cli/main.ts",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "biome lint --write",
    "lint:check": "biome lint",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "coverage": "bun test --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2",
    "ajv": "8.20.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "3.1143.0",
    "@aws-sdk/client-s3": "3.1143.0",
    "@aws-sdk/client-secrets-manager": "3.1143.0",
    "@aws-sdk/client-service-quotas": "3.1143.0",
    "@aws-sdk/client-sts": "3.1143.0",
    "@aws-sdk/credential-provider-ini": "3.973.17"
  }
}
