{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yaunder/factory/schemas/doctor-report.schema.json",
  "title": "fffactory doctor --json report, schema version 1",
  "description": "Consumers must ignore capability and check IDs, and fields, they do not know.",
  "type": "object",
  "required": ["schema_version", "release", "status", "capabilities"],
  "properties": {
    "schema_version": { "const": 1 },
    "release": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$" },
    "status": { "$ref": "#/$defs/status" },
    "capabilities": { "type": "array", "items": { "$ref": "#/$defs/capability" } }
  },
  "$defs": {
    "status": { "enum": ["ready", "not_ready", "error"] },
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "capability": {
      "type": "object",
      "required": ["id", "title", "status", "checks"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "checks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/check" } }
      }
    },
    "check": {
      "type": "object",
      "required": ["id", "title", "status", "summary", "details", "next_action"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "summary": { "type": "string", "minLength": 1 },
        "details": { "type": "array", "items": { "type": "string" } },
        "next_action": { "type": ["string", "null"] }
      },
      "if": { "properties": { "status": { "const": "ready" } } },
      "then": { "properties": { "next_action": { "type": "null" } } },
      "else": { "properties": { "next_action": { "type": "string", "minLength": 1 } } }
    }
  }
}
